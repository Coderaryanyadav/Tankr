# TANKR Environment Configuration Template
# DO NOT COMMIT SENSITIVE SERVICE ROLE KEYS TO SOURCE REPOSITORIES

# Supabase Public Configuration (Safe for Client App)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Payment Gateway Configuration (Public Key / Key ID only)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Mappls (MapmyIndia) Public REST Key (Safe for Client App)
# Obtained from: https://auth.mappls.com/console/#/home/dashboard/applications
EXPO_PUBLIC_MAPPLS_REST_KEY=your_mappls_rest_api_key

