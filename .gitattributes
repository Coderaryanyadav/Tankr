# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force scripts to use LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Explicit text formats
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.sql text
*.toml text
*.yml text
*.yaml text

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
